OPENCIVICQUERY_CONFIG_PATH=deployments/local.yaml
OPENCIVICQUERY_AUTH_MODE=open
OPENCIVICQUERY_TRANSPORT=http
OPENCIVICQUERY_SNAPSHOT_BACKEND=local
OPENCIVICQUERY_SNAPSHOT_PATH=/tmp/opencivicquery-snapshots
OPENCIVICQUERY_LOG_LEVEL=INFO

# Required by deployments/public.yaml and any deployment that names app_token_env.
# OPENCIVICQUERY_SOCRATA_APP_TOKEN=replace-me

# Required only when OPENCIVICQUERY_AUTH_MODE=oauth.
# The issuer is this service, not accounts.google.com: the server publishes its own
# authorization server metadata so it can advertise offline_access, which Google does
# not. Point it at Google and clients skip the proxy and lose the refresh token.
# OPENCIVICQUERY_OAUTH_ISSUER_URL=https://your-service.example.org
# Must match the URL a user types into the client, path included.
# OPENCIVICQUERY_OAUTH_RESOURCE_URL=https://your-service.example.org/mcp
# OPENCIVICQUERY_OAUTH_CLIENT_ID=your-google-oauth-client-id
# OPENCIVICQUERY_OAUTH_ADDITIONAL_CLIENT_IDS=
# Exact downstream callbacks, comma separated.
# OPENCIVICQUERY_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
# OPENCIVICQUERY_ALLOWED_USERS=person@example.com
