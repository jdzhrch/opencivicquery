<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the SF.gov daily copy once a day at 05:30 local time. See operations/sfgov-copy.md.
  Replace __REPOSITORY__, __UV__, __BUCKET__, __KEYCHAIN_ITEM__, and __LOG__ before loading.
  __REPOSITORY__ is best a clone kept only for this job, so it never runs unfinished work.
  The job reads the bucket key from the login Keychain item __KEYCHAIN_ITEM__, where it is
  kept base64-encoded, and hands it to the command on standard input, so no key file sits on
  disk.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.opencivicquery.sfgov-copy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>/usr/bin/security find-generic-password -s __KEYCHAIN_ITEM__ -w | /usr/bin/base64 --decode | __UV__ run --directory __REPOSITORY__ --frozen --no-dev opencivicquery sfgov-copy --bucket __BUCKET__ --key-stdin</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>5</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
